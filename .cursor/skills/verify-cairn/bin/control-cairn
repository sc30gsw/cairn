#!/usr/bin/env python3
"""Cairn の隔離された実機検証を起動・診断・終了する。"""
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import time
import urllib.request

ROOT = Path(__file__).resolve().parents[4]
RUN = os.environ.get("CAIRN_VERIFY_RUN_ID", "")
if not re.fullmatch(r"[a-zA-Z0-9_]{1,32}", RUN):
    sys.exit("Set CAIRN_VERIFY_RUN_ID to 1–32 ASCII letters, digits or underscores")
STATE = Path("/tmp") / f"cairn-verify-{RUN}"
WORK = STATE / "app"
SOCKET = str(STATE / "tmux.sock")
ART = STATE / "artifacts"
URL = "http://localhost:3000"
ENV = {k: v for k, v in os.environ.items() if not k.startswith(
    ("CONVEX_", "VITE_", "BETTER_AUTH_", "GOOGLE_", "NOTION_", "AUTH_")) and k != "SITE_URL"}
ENV["CONVEX_AGENT_MODE"] = "anonymous"


def run(args, **kwargs):
    return subprocess.run(args, check=True, text=True, capture_output=True,
                          env=ENV, **kwargs).stdout.strip()


def tmux(*args):
    return run(["tmux", "-S", SOCKET, "-f", "/dev/null", *args])


def alive(name):
    try:
        tmux("has-session", "-t", "=" + name)
        return True
    except subprocess.CalledProcessError:
        return False


def listeners(port):
    result = subprocess.run(["lsof", "-nP", "-t", f"-iTCP:{port}", "-sTCP:LISTEN"],
                            text=True, capture_output=True)
    if result.returncode not in (0, 1):
        raise RuntimeError(result.stderr)
    return {int(pid) for pid in result.stdout.split()}


def descendants(pid):
    rows = run(["ps", "-axo", "pid=,ppid="]).splitlines()
    pairs = [tuple(map(int, row.split())) for row in rows]
    found = {pid}
    while True:
        more = {child for child, parent in pairs if parent in found}
        if more <= found:
            return found
        found |= more


def owned(name, port):
    if not alive(name):
        return False
    pid = int(tmux("display-message", "-p", "-t", name, "#{pane_pid}"))
    pids = listeners(port)
    return bool(pids) and pids <= descendants(pid)


def http(url):
    try:
        with urllib.request.urlopen(url, timeout=3) as response:
            return response.status, response.read().decode()
    except (OSError, ValueError):
        return 0, ""


def wait_for(test, description, timeout=180):
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        if (STATE / "cleaned.txt").exists():
            raise RuntimeError("Run was cleaned up")
        if test():
            print("control-cairn: ready — " + description, flush=True)
            return
        time.sleep(1)
    raise RuntimeError("Timed out: " + description + "; inspect " + str(STATE / "logs"))


def start(name, args):
    log = STATE / "logs" / (name + ".log")
    command = "exec " + shlex.join(args) + " > " + shlex.quote(str(log)) + " 2>&1"
    tmux("new-session", "-d", "-s", name, "-c", str(WORK), command)


def record_listeners(name, ports):
    pid = int(tmux("display-message", "-p", "-t", name, "#{pane_pid}"))
    tree = descendants(pid)
    path = STATE / "owned-listeners.json"
    recorded = json.loads(path.read_text()) if path.exists() else {}
    for port in ports:
        pids = listeners(port)
        if not pids or not pids <= tree:
            raise RuntimeError(f"Cannot record ownership for port {port}")
        recorded[str(port)] = sorted(pids)
    path.write_text(json.dumps(recorded, indent=2) + "\n")


def stop_recorded_listeners():
    path = STATE / "owned-listeners.json"
    if not path.exists():
        return
    recorded = json.loads(path.read_text())
    targets = set()
    for port, pids in recorded.items():
        targets |= listeners(int(port)) & set(pids)
    for sig in (signal.SIGTERM, signal.SIGKILL):
        for pid in targets:
            try:
                os.kill(pid, sig)
            except ProcessLookupError:
                pass
        for _ in range(10):
            remaining = {pid for pid in targets if Path(f"/proc/{pid}").exists()} if sys.platform != "darwin" else set()
            if sys.platform == "darwin":
                remaining = set()
                for port, pids in recorded.items():
                    remaining |= listeners(int(port)) & set(pids)
            if not remaining:
                return
            time.sleep(0.2)
        targets = remaining


def local_env():
    path = WORK / ".env.local"
    if not path.exists():
        return False
    values = dict(line.split("=", 1) for line in path.read_text().splitlines()
                  if "=" in line and not line.startswith("#"))
    deployment = values.get("CONVEX_DEPLOYMENT", "").split(" #", 1)[0].strip()
    return (deployment.startswith("anonymous:") or deployment.startswith("local:")) and (
        values.get("VITE_CONVEX_URL") == "http://127.0.0.1:3210")


def load_state():
    data = json.loads((STATE / "run.json").read_text())
    if data["root"] != str(ROOT) or data["run"] != RUN:
        raise RuntimeError("Run ownership mismatch")
    return data


def cleanup():
    if not (STATE / "run.json").exists():
        print("control-cairn: no owned run to clean")
        return
    load_state()
    browser_error = None
    if (STATE / "browser-started").exists():
        try:
            run(["playwright-cli", "-s=cairn-verify-" + RUN, "close"], cwd=STATE)
            (STATE / "browser-started").unlink()
        except (OSError, subprocess.CalledProcessError) as error:
            browser_error = error
    for name in ("web", "convex"):
        if alive(name):
            tmux("send-keys", "-t", name, "C-c")
            for _ in range(10):
                if not alive(name):
                    break
                time.sleep(0.3)
            if alive(name):
                tmux("kill-session", "-t", name)
    stop_recorded_listeners()
    # 専用ソケットのサーバーだけを終了する。
    if Path(SOCKET).exists():
        try:
            tmux("kill-server")
        except subprocess.CalledProcessError:
            pass
    if WORK.exists():
        shutil.rmtree(WORK)
    (STATE / "auth.env").unlink(missing_ok=True)
    (STATE / "cleaned.txt").write_text("Owned sessions and disposable app removed; evidence retained.\n")
    if browser_error is not None:
        raise RuntimeError("Servers cleaned; browser close failed, retry cleanup: " + str(browser_error))
    print("control-cairn: cleanup done; evidence kept at " + str(ART))


def launch():
    for tool in ("vp", "tmux", "lsof", "git", "playwright-cli"):
        if shutil.which(tool) is None:
            raise RuntimeError("Missing tool: " + tool)
    version = run(["vp", "exec", "node", "-p", "process.versions.node"], cwd=ROOT)
    if tuple(map(int, version.split("."))) < (24, 17, 0):
        raise RuntimeError("Need Node >=24.17.0; vp selected " + version)
    if not (ROOT / "node_modules").is_dir():
        raise RuntimeError("Run vp install first")
    if STATE.exists():
        raise RuntimeError("Run directory exists; use a new run ID (evidence is never overwritten)")
    for port in (3000, 3210, 3211):
        if listeners(port):
            raise RuntimeError(f"Port {port} is occupied; do not reuse or stop its owner")
        with socket.socket() as probe:
            probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            probe.bind(("127.0.0.1", port))
    STATE.mkdir(mode=0o700)
    (STATE / "logs").mkdir()
    ART.mkdir()
    (STATE / "run.json").write_text(json.dumps({
        "root": str(ROOT), "run": RUN, "node": version,
        "revision": run(["git", "rev-parse", "HEAD"], cwd=ROOT),
    }, indent=2) + "\n")
    try:
        WORK.mkdir()
        files = run(["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"], cwd=ROOT)
        manifest = {}
        for name in sorted(set(files.split("\0"))):
            parts = Path(name).parts
            if not parts or parts[0] in (".agents", ".claude", ".cursor", "graft"):
                continue
            if any(part.startswith(".env") for part in parts):
                continue
            source = ROOT / name
            if not source.is_file() or source.is_symlink():
                continue
            target = WORK / name
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, target)
            manifest[name] = hashlib.sha256(target.read_bytes()).hexdigest()
        (STATE / "source-manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
        if sys.platform == "darwin":
            run(["cp", "-cR", str(ROOT / "node_modules"), str(WORK / "node_modules")])
        else:
            run(["cp", "-a", "--reflink=auto", str(ROOT / "node_modules"), str(WORK / "node_modules")])
        start("convex", ["vp", "exec", "convex", "dev", "--typecheck", "disable"])
        wait_for(lambda: local_env() and owned("convex", 3210) and http("http://127.0.0.1:3210/version")[0] == 200,
                 "owned local Convex and anonymous .env.local")
        record_listeners("convex", (3210, 3211))
        auth = STATE / "auth.env"
        auth.write_text("BETTER_AUTH_SECRET=" + secrets.token_hex(32) + "\nSITE_URL=" + URL +
                        "\nBETTER_AUTH_TRUSTED_ORIGINS=" + URL + "\n")
        run(["vp", "exec", "convex", "env", "set", "--from-file", str(auth)], cwd=WORK)
        auth.unlink()
        with (WORK / ".env.local").open("a") as envfile:
            envfile.write("\nVITE_SITE_URL=" + URL + "\nSITE_URL=" + URL + "\n")
        wait_for(lambda: "Convex functions ready" in (STATE / "logs/convex.log").read_text(),
                 "Convex functions deployed")
        start("web", ["vp", "dev", "--host", "127.0.0.1", "--port", "3000", "--strictPort"])
        wait_for(lambda: owned("web", 3000) and http(URL)[0] == 200, "owned Cairn web")
        record_listeners("web", (3000,))
        doctor()
    except BaseException:
        cleanup()
        raise


def doctor():
    data = load_state()
    if not local_env():
        raise RuntimeError("Scratch app is not configured for anonymous local Convex")
    for name, port in (("web", 3000), ("convex", 3210), ("convex", 3211)):
        if not owned(name, port):
            raise RuntimeError(f"Port {port} not owned by this run's {name} session")
    status, body = http(URL)
    if status != 200 or "学習ログ" not in body:
        raise RuntimeError("Cairn document is unavailable or has wrong identity")
    status, body = http(URL + "/api/auth/get-session")
    if status != 200 or body.strip() != "null":
        raise RuntimeError("Anonymous auth endpoint is unhealthy: " + str(status))
    if http("http://127.0.0.1:3210/version")[0] != 200:
        raise RuntimeError("Convex version endpoint unavailable")
    print("control-cairn: doctor OK; owned ports 3000/3210/3211; auth null (signed out)")
    print("source revision=" + data["revision"] + "; node=" + data["node"])
    print("source manifest=" + str(STATE / "source-manifest.json"))
    print("artifacts=" + str(ART))


def browser():
    doctor()
    (STATE / "browser-started").touch()
    print(run(["playwright-cli", "-s=cairn-verify-" + RUN, "open", URL], cwd=STATE))
    print(run(["playwright-cli", "-s=cairn-verify-" + RUN, "resize", "1280", "900"], cwd=STATE))


def interrupted(signum, frame):
    raise KeyboardInterrupt("Verification interrupted")


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, interrupted)
    try:
        actions = {"launch": launch, "doctor": doctor, "browser": browser, "cleanup": cleanup}
        if len(sys.argv) != 2 or sys.argv[1] not in actions:
            sys.exit("usage: control-cairn <launch|doctor|browser|cleanup>")
        actions[sys.argv[1]]()
    except (RuntimeError, OSError, subprocess.CalledProcessError) as error:
        print("control-cairn: " + str(error), file=sys.stderr)
        if isinstance(error, subprocess.CalledProcessError):
            print(error.stderr, file=sys.stderr)
        sys.exit(1)
