{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    /* Strict */
    "strict": true,
    "libReplacement": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,

    /* Bundler mode */
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "paths": {
      "~/*": ["./src/*"],
      "~domain/*": ["./convex/lib/*"]
    }
  },
  "exclude": ["convex/_generated", "convex/betterAuth/_generated"],
  "include": ["src", "*.config.ts", "convex"]
}
